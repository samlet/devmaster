# 控制台环境变量。复制为 .env.local 后生效（`make web-env` 会自动生成）。
# .env.local 不进仓库；这里的值是本地开发用的示例值，生产必须替换。

# 后端 HTTP 面
DEVMASTER_API_URL=http://127.0.0.1:8291

# BFF 签名密钥：必须与后端 configs/local.yaml 的 integrations.bff_shared_secret 一致，
# 否则写端点会返回 invalid bff signature。
DEVMASTER_BFF_SECRET=devmaster-local-bff-secret-0123456789

# 会话加密密钥（≥32 字符）。本地由 make web-env 随机生成；
# 生产从密钥管理注入，不写进任何文件。
DEVMASTER_SESSION_SECRET=

# 控制台登录用的 IdP（scripts/keycloak-dev.sh 起的实例）
DEVMASTER_OIDC_ISSUER=http://127.0.0.1:18281/realms/devmaster
DEVMASTER_OIDC_CLIENT_ID=devmaster-web
DEVMASTER_OIDC_REDIRECT_URI=http://127.0.0.1:3031/api/auth/callback

# 本地没有 IdP 时设为 dev：跳过 Keycloak，直接以 DEVMASTER_CONSOLE_SUBJECT 登录。
# 默认走 oidc。
# DEVMASTER_AUTH_MODE=dev
# DEVMASTER_CONSOLE_SUBJECT=local-dev
