{
  "realm": "devmaster",
  "displayName": "Devmaster",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "DEV_VIEWER",
        "description": "只读"
      },
      {
        "name": "DEV_MEMBER",
        "description": "工作项与工时"
      },
      {
        "name": "DEV_LEAD",
        "description": "冲刺与版本范围"
      },
      {
        "name": "RELEASE_APPROVER",
        "description": "发布审批"
      },
      {
        "name": "DEV_ADMIN",
        "description": "管理"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "claim.name": "name",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "email",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "access.token.claim": "true",
            "id.token.claim": "true",
            "user.attribute": "emailVerified",
            "claim.name": "email_verified",
            "jsonType.label": "boolean"
          }
        }
      ]
    },
    {
      "name": "devmaster-context",
      "description": "组织声明与租户上下文",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "org-ids",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "org_ids",
            "claim.name": "org_ids",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "devmaster-web",
      "name": "Devmaster Console",
      "description": "Next.js 控制台：Authorization Code + PKCE",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:3031/api/auth/callback",
        "http://localhost:3031/api/auth/callback"
      ],
      "webOrigins": [
        "http://127.0.0.1:3031",
        "http://localhost:3031"
      ],
      "defaultClientScopes": [
        "roles",
        "profile",
        "email",
        "devmaster-context"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:3031/*"
      }
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@devmaster.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Chen",
      "attributes": {
        "org_ids": [
          "00000000-0000-0000-0000-000000000001"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "devmaster",
          "temporary": false
        }
      ],
      "realmRoles": [
        "DEV_MEMBER",
        "DEV_LEAD"
      ],
      "id": "aaaaaaaa-1111-4111-8111-aaaaaaaaaaaa"
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@devmaster.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Liu",
      "attributes": {
        "org_ids": [
          "00000000-0000-0000-0000-000000000001"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "devmaster",
          "temporary": false
        }
      ],
      "realmRoles": [
        "DEV_MEMBER",
        "RELEASE_APPROVER"
      ],
      "id": "bbbbbbbb-2222-4222-8222-bbbbbbbbbbbb"
    }
  ]
}